<mxfile host="app.diagrams.net" modified="2026-10-26T00:00:00.000Z" agent="BookBox diagrams" version="24.7.17" type="device">
  <diagram id="menu-states" name="menu-states">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="&lt;b&gt;S0. Гость, главная&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Каталог · Новинки · Скидки · Подборки&lt;br&gt;Доставка · О нас · Поиск · Корзина · Войти&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F2;strokeColor=#2F5D62;fontColor=#1F3E42;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="685" y="80" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;S1. Гость, каталог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Глобальное меню + фасеты и сортировка&lt;br&gt;«В корзину» → «Войти»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F2;strokeColor=#2F5D62;fontColor=#1F3E42;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="200" y="250" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;S2. Гость, книга&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Избранное и «Купить сейчас» просят вход&lt;br&gt;Корзина доступна&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#B87333;fontColor=#6B4416;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="250" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;S7. Помощь / инфо&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Полное глобальное меню&lt;br&gt;Доставка, оплата, возврат, FAQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F1F7;strokeColor=#7A5C9E;fontColor=#4A3563;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="840" y="250" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;S8. Вход / регистрация&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Только логотип и «Назад»&lt;br&gt;Глобальное меню скрыто&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F6F3;strokeColor=#9C968A;fontColor=#4B5563;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;S3. Авторизован&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Все пункты + Избранное + Профиль&lt;br&gt;Корзина со счётчиком&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#3B5BA5;fontColor=#243A6B;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="685" y="420" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;S4. Корзина / checkout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Меню и footer скрыты&lt;br&gt;Степпер 1 → 2 → 3 → 4, «Назад»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#B87333;fontColor=#6B4416;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="350" y="590" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;S5. Личный кабинет&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Табы: Профиль · Адреса · Заказы&lt;br&gt;Избранное · Отзывы · Подписки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#3B5BA5;fontColor=#243A6B;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="685" y="590" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;S6. Админ-панель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6472&quot;&gt;Своё меню: Каталог · Заказы · Пользователи&lt;br&gt;Отзывы · Подборки · Аналитика · Настройки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFEF;strokeColor=#A44A4A;fontColor=#6B2C2C;fontSize=13;fontStyle=1;align=center;arcSize=8" vertex="1" parent="1"><mxGeometry x="1030" y="590" width="230" height="96" as="geometry"/></mxCell>
