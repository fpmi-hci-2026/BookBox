flowchart TD
  Start([Начало]) --> A["Покупатель: открывает карточку"]
  A --> B{"Предзаказ доступен?"}
  B -->|Нет| C["BookBox: сообщает о недоступности"]
  B -->|Да| D["BookBox: показывает форму и ожидаемый срок"]
  D --> E["Покупатель: подтверждает предзаказ"]
  E --> F{"Предзаказ всё ещё доступен?"}
  F -->|Нет| G["BookBox: показывает актуальное состояние книги"]
  F -->|Да| H["BookBox: сохраняет предзаказ со статусом «Ожидает поступления»"]
  H --> I["BookBox: показывает номер предзаказа"]
  C --> Stop([Конец])
  G --> Stop
  I --> Stop
