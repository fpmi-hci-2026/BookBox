@startuml
skinparam defaultFontName Arial
title Оформление заказа с онлайн-оплатой

|Покупатель|
start
:Перейти к оформлению из корзины;
:Указать адрес и способ доставки;

|BookBox|
:Проверить наличие книг;
if (Все книги в наличии?) then (да)
  :Показать итоговую сумму;
else (нет)
  :Сообщить, какая книга недоступна;
  |Покупатель|
  :Вернуться в корзину;
  stop
endif

repeat
  |Покупатель|
  :Подтвердить онлайн-оплату;
  |BookBox|
  :Отправить запрос на оплату;
  if (Платёж подтверждён?) then (да)
    :Подтвердить заказ;
    :Показать номер заказа;
    stop
  else (нет)
    :Сообщить об ошибке и сохранить данные заказа;
  endif
  |Покупатель|
repeat while (Повторить оплату?) is (да) not (нет)

:Выйти из оформления;
stop
@enduml
